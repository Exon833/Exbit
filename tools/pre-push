#!/bin/sh
# Git's pre-push hook: the tests the pushed commits reach run before a push (`make test-affected`, picked by
# tools/affected_tests.sh from what the remote already has); every test when that can't be told. Installed by
# `make hooks` (a link in .git/hooks); `git push --no-verify` skips it once. Not for the unstable branch (pushed
# untested), the webpage's gh-pages branch, tags (the release's) or a branch being deleted.
cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
need=0 base= all=0
while read -r localRef localSha remoteRef remoteSha; do
    case "$remoteRef" in
    refs/heads/unstable | refs/heads/gh-pages | refs/tags/*) continue ;;
    esac
    [ "$localSha" = "$zero" ] && continue
    need=1
    # from what the remote has (a new branch: from where it left main); unknown, or not what is checked out: all
    from=$remoteSha
    [ "$from" = "$zero" ] && from=$(git merge-base "$localSha" origin/main 2>/dev/null)
    if [ -z "$from" ] || ! git cat-file -e "$from^{commit}" 2>/dev/null || [ "$localSha" != "$(git rev-parse HEAD)" ] ||
        { [ -n "$base" ] && [ "$base" != "$from" ]; }; then
        all=1
    fi
    base=$from
done
[ "$need" = 1 ] || exit 0
if [ "$all" = 1 ]; then
    echo "pre-push: make test, every test (git push --no-verify skips it)"
    exec make -j"$(nproc)" test
fi
echo "pre-push: make test-affected BASE=$(git rev-parse --short "$base") (git push --no-verify skips it)"
exec make -j"$(nproc)" test-affected BASE="$base"
