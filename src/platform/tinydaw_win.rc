// Tiny DAW's Windows resources (the Makefile: windres), in tinydaw.exe and the plugin hosts:
// the manifest (1: CREATEPROCESS_MANIFEST_RESOURCE_ID, 24: RT_MANIFEST)
1 24 "tinydaw_win.manifest"

// the icon (Explorer, the taskbar, and the window class: platform_win.cpp loads it as 1): data/icons/tinydaw.svg drawn
// at 16-256 px, PNG images in an ICO (Windows Vista and later). After changing the SVG, remake it:
//   for n in 16 20 24 32 40 48 64 256; do rsvg-convert -w $n -h $n data/icons/tinydaw.svg -o $n.png; done
//   and pack them (the ICO format: a 6-byte header, a 16-byte entry per image, then the PNGs)
1 ICON "tinydaw_win.ico"

// what Explorer's Properties > Details shows (a rolling release: no version numbers, the main branch is the program)
1 VERSIONINFO
FILEVERSION 0, 0, 0, 0
PRODUCTVERSION 0, 0, 0, 0
FILEOS 0x40004      // VOS_NT_WINDOWS32
FILETYPE 0x1        // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"  // US English, Unicode
        BEGIN
            VALUE "ProductName", "Tiny DAW"
            VALUE "FileDescription", "Tiny DAW"
            VALUE "ProductVersion", "rolling release (GitHub: Exon833/Tiny-DAW, main branch)"
            VALUE "FileVersion", "rolling release"
            VALUE "LegalCopyright", "GNU General Public License, version 3"
            VALUE "Comments", "A free, open-source digital audio workstation"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
